module conditionals;

fn abs_value(x: i64) -> i64
ensures non_negative: result >= 0;
{
  let magnitude: i64 = if x >= 0 { x } else { -x };
  return magnitude;
}

fn choose(flag: bool, a: i64, b: i64) -> i64
ensures when_true: !flag || result == a;
ensures when_false: flag || result == b;
{
  return if flag { a } else { b };
}
