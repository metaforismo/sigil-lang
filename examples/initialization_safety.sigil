module initialization_safety;

fn initialize_slot(length: i64, index: i64, value: i64) -> bool
requires valid_length: length > 0;
requires valid_index: index >= 0 && index < length;
ensures safe: result;
{
  let raw: Slice[i64] = allocate_uninit_slice(length, 0);
  assert starts_uninitialized: !is_initialized(raw, index);
  let exclusive: Slice[i64] = borrow_mut(raw);
  let initialized: Slice[i64] = store(exclusive, index, value);
  assert marked_initialized: is_initialized(initialized, index);
  assert exact_value: at(initialized, index) == value;
  return is_live(initialized) && is_initialized(initialized, index);
}

fn initialization_follows_views() -> bool
{
  let raw: Slice[bool] = allocate_uninit_slice(4, false);
  let view: Slice[bool] = slice_view(raw, 1, 2);
  assert raw_uninitialized: !is_initialized(raw, 1);
  assert view_uninitialized: !is_initialized(view, 0);
  let exclusive: Slice[bool] = borrow_mut(view);
  let initialized: Slice[bool] = store(exclusive, 0, true);
  assert view_initialized: is_initialized(initialized, 0);
  assert exact_value: at(initialized, 0);
  return !is_initialized(raw, 1) && is_initialized(initialized, 0);
}

fn initialized_constructor() -> bool
{
  let values: Array[i64] = allocate_array(2, 7);
  assert first_initialized: is_initialized(values, 0);
  assert second_initialized: is_initialized(values, 1);
  return at(values, 1) == 7;
}
