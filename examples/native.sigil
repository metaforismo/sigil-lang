module native;

fn add_one(x: i64) -> i64
requires bounded_input: x >= 0;
ensures advanced: result > x;
{
  let y: i64 = x;
  y = y + 1;
  return y;
}

fn choose(flag: bool, x: i64) -> i64
requires non_negative: x >= 0;
ensures preserved: result >= 0;
{
  if flag {
    return x;
  } else {
    return 0;
  }
}

fn abs_value(x: i64) -> i64
ensures non_negative: result >= 0;
{
  let y: i64 = if x >= 0 { x } else { -x };
  return y;
}

fn nonzero(x: i64) -> bool
ensures same_truth: result == (x != 0);
{
  return x != 0;
}

fn sum3(a: i64, b: i64, c: i64) -> i64
ensures exact: result == a + b + c;
{
  let total: i64 = a + b;
  total = total + c;
  return total;
}

fn choose3(first: bool, second: bool, x: i64) -> i64
requires non_negative: x >= 0;
ensures preserved: result >= 0;
{
  if first {
    return x;
  } else {
    if second {
      return x + 1;
    } else {
      return 0;
    }
  }
}

fn sum4(a: i64, b: i64, c: i64, d: i64) -> i64
ensures exact: result == a + b + c + d;
{
  let total: i64 = a + b;
  total = total + c;
  total = total + d;
  return total;
}

fn sum8(a: i64, b: i64, c: i64, d: i64, e: i64, f: i64, g: i64, h: i64) -> i64
ensures exact: result == a + b + c + d + e + f + g + h;
{
  let total: i64 = a + b;
  total = total + c;
  total = total + d;
  total = total + e;
  total = total + f;
  total = total + g;
  total = total + h;
  return total;
}

fn all4(a: bool, b: bool, c: bool, d: bool) -> bool
ensures exact: result == (a && b && c && d);
{
  return a && b && c && d;
}

fn all8(a: bool, b: bool, c: bool, d: bool, e: bool, f: bool, g: bool, h: bool) -> bool
ensures exact: result == (a && b && c && d && e && f && g && h);
{
  return a && b && c && d && e && f && g && h;
}

fn observe(flag: bool, x: i64) -> void
requires non_negative: x >= 0;
ensures preserved: x >= 0;
{
  if flag {
    return;
  } else {
    assume keep_going: true;
  }
}
