module model_epochs;

fn observe_epoch(values: Slice[i64]) -> i64
ensures exact: result == epoch(values);
{
  return epoch(values);
}

fn array_store_advances(values: Array[bool], index: i64, value: bool) -> i64
requires live: is_live(values);
requires owned: has_owner(values);
requires exclusive: has_mut_borrow(values);
requires in_bounds: index >= 0 && index < len(values);
ensures advanced: result == epoch(values) + 1;
{
  let updated: Array[bool] = store(values, index, value);
  return epoch(updated);
}

fn view_preserves_epoch(values: Slice[i64], start: i64, count: i64) -> bool
requires live: is_live(values);
requires in_bounds: start >= 0 && count >= 0 && start + count <= len(values);
ensures preserved: result;
{
  let view: Slice[i64] = slice_view(values, start, count);
  return same_snapshot(view, values);
}

fn borrow_preserves_epoch(values: Array[i64]) -> bool
requires live: is_live(values);
requires owned: has_owner(values);
requires no_shared: shared_borrows(values) == 0;
requires no_mutable: !has_mut_borrow(values);
ensures preserved: result;
{
  let borrowed: Array[i64] = borrow_mut(values);
  return same_snapshot(borrowed, values);
}

fn allocations_start_distinct() -> bool
ensures exact: result;
{
  let first: Array[i64] = allocate_array(1, 0);
  let second: Slice[i64] = allocate_slice(1, 0);
  return epoch(first) == 0 && epoch(second) == 0 && !same_snapshot(first, second);
}

fn deallocation_advances(values: Array[i64]) -> bool
requires live: is_live(values);
requires owned: has_owner(values);
requires no_shared: shared_borrows(values) == 0;
requires no_mutable: !has_mut_borrow(values);
ensures advanced: result;
{
  let before: i64 = epoch(values);
  let dead: Array[i64] = deallocate(values);
  return epoch(dead) == before + 1;
}
